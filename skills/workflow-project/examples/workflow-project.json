{
  "project": {
    "name": "The Workflow Project skill",
    "accent": "Workflow",
    "prepared_by": "WorkSpace Labs",
    "date": "2026-11-12",
    "version": "0.4.0",
    "summary": "A skill for every AI agent. When someone asks for a new project or a new skill, the agent first understands it, then draws how it will work from A to Z as a clean workflow PDF, before anything is built. For a project that is already built, it reads the project first and draws how it works today.",
    "actors": [
      {"name": "You", "role": "The person who asks for the project and says yes."},
      {"name": "The AI", "role": "The agent that plans or builds it: Claude, Codex, Grok, ChatGPT or another."},
      {"name": "Drawing tool", "role": "The small program inside the skill that checks the file and draws the PDF."}
    ],
    "assumptions": ["The agent can run Python with the reportlab package."],
    "open_questions": []
  },
  "parts": [
    {
      "title": "What was asked",
      "summary": "A new project goes straight on, and a built one is read first. A new skill is looked up first, then you build ours or install the one that exists.",
      "lanes": ["You", "The AI"],
      "nodes": [
        {"id": "start", "type": "start", "lane": "You", "title": "Asks for something new"},
        {"id": "skill", "type": "decision", "lane": "The AI", "title": "A new skill?",
         "branches": [{"label": "No", "to": "ready"}, {"label": "Yes", "to": "search"}]},
        {"id": "search", "type": "step", "lane": "The AI", "title": "Looks for an existing skill", "detail": "installed and public ones"},
        {"id": "exists", "type": "decision", "lane": "The AI", "title": "One exists?",
         "branches": [{"label": "No", "to": "ready"}, {"label": "Yes", "to": "build"}]},
        {"id": "build", "type": "decision", "lane": "You", "title": "Build ours?",
         "branches": [{"label": "Yes", "to": "ready"}, {"label": "No", "to": "install"}]},
        {"id": "install", "type": "stop", "lane": "You", "title": "Install it", "detail": "the one that already exists"},
        {"id": "ready", "type": "end", "lane": "The AI", "title": "Ready to ask", "to_part": 2}
      ]
    },
    {
      "title": "Say it back",
      "summary": "The agent asks, you answer, and it repeats the idea until you say yes.",
      "lanes": ["You", "The AI"],
      "nodes": [
        {"id": "start", "type": "start", "lane": "The AI", "title": "Ready to ask"},
        {"id": "ask", "type": "step", "lane": "The AI", "title": "Asks the questions", "detail": "who, what, every decision", "result": "Your answers"},
        {"id": "answer", "type": "step", "lane": "You", "title": "Answers", "detail": "clicks or your own words"},
        {"id": "readback", "type": "step", "lane": "The AI", "title": "Says it back", "detail": "in its own words", "result": "A read-back"},
        {"id": "right", "type": "decision", "lane": "You", "title": "That's it?",
         "branches": [{"label": "Yes", "to": "understood"}, {"label": "No", "to": "ask"}]},
        {"id": "understood", "type": "end", "lane": "The AI", "title": "Understood", "to_part": 3}
      ]
    },
    {
      "title": "Map and draw",
      "summary": "The agent writes the workflow file; the drawing tool refuses anything messy.",
      "lanes": ["The AI", "Drawing tool"],
      "nodes": [
        {"id": "start", "type": "start", "lane": "The AI", "title": "Understood"},
        {"id": "map", "type": "step", "lane": "The AI", "title": "Maps the workflow", "detail": "parts, people, steps, decisions", "result": "The map in its head"},
        {"id": "write", "type": "step", "lane": "The AI", "title": "Writes the workflow file", "result": "workflow.json"},
        {"id": "check", "type": "step", "lane": "Drawing tool", "title": "Checks the file", "detail": "and routes every arrow"},
        {"id": "clean", "type": "decision", "lane": "Drawing tool", "title": "Clean?",
         "branches": [{"label": "Yes", "to": "draw"}, {"label": "No", "to": "fix"}]},
        {"id": "fix", "type": "step", "lane": "The AI", "title": "Fixes what it says", "next": "check"},
        {"id": "draw", "type": "step", "lane": "Drawing tool", "title": "Draws the PDF", "detail": "in the house look", "result": "The workflow PDF"},
        {"id": "ready", "type": "end", "lane": "The AI", "title": "PDF ready", "to_part": 4}
      ]
    },
    {
      "title": "Check and hand over",
      "summary": "The agent looks at every page, then hands the PDF to you.",
      "lanes": ["You", "The AI"],
      "nodes": [
        {"id": "start", "type": "start", "lane": "The AI", "title": "PDF ready"},
        {"id": "look", "type": "step", "lane": "The AI", "title": "Looks at every page", "result": "Pages checked"},
        {"id": "send", "type": "step", "lane": "The AI", "title": "Hands it to you", "detail": "with anything still open"},
        {"id": "ok", "type": "decision", "lane": "You", "title": "Right?",
         "branches": [{"label": "Yes", "to": "build"}, {"label": "No", "to": "change"}]},
        {"id": "change", "type": "step", "lane": "The AI", "title": "Changes the workflow", "detail": "what you pointed at", "next": "look"},
        {"id": "build", "type": "end", "lane": "You", "title": "Ready to build"}
      ]
    }
  ]
}
